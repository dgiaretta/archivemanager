<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>info.oais.infomodel</groupId>
    <artifactId>oais-structure-adapters</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>oais-structure-kaitai</artifactId>
  <name>oais-structure-kaitai</name>
  <description>
    ExecutableStructureRepInfo backed by a Kaitai-Struct-generated Java
    parser class, bridged generically (via reflection over the generated
    class's own getters) rather than per-format.
  </description>

  <dependencies>
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-api</artifactId>
    </dependency>

    <dependency>
      <groupId>io.kaitai</groupId>
      <artifactId>kaitai-struct-runtime</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    src/main/ksy/*.ksy are the source of truth for the demo formats;
    src/main/java/.../generated/*.java were generated from them by the real
    Kaitai Struct compiler 0.11 in debug mode and are checked in, so this
    build needs no compiler. Regenerate after editing a .ksy - see
    README-KAITAI.md for the exact command. Debug mode is what makes the
    classes record per-field byte offsets (their _attrStart/_attrEnd maps),
    which KaitaiReflectiveStructureNode turns into source ranges.
  -->
</project>
