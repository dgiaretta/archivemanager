# A0 V star spectrum: Representation Information for TOPCAT and SPLAT
#
# A Representation Information manifest: the Data Object(s) below, where their
# bits are, and the OAIS Representation Information needed to interpret them --
# structure descriptions (equivalent alternatives: any one will do), how to view
# the data, and what its elements mean. Every file is named explicitly; relative
# locations resolve against this file's own location.

@prefix im:     <http://ontology.oais.info/im/> .
@prefix bridge: <https://oais.info/bridge#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix rico:   <https://www.ica.org/standards/RiC/ontology#> .

<#a0-v-star-spectrum> a im:DigitalObject ;
    rdfs:label "A0 V star spectrum" ;
    bridge:hasStorageLocation <a0v-spectrum.bin> ;
    im:interpretedUsing <#a0-v-star-spectrum-repinfo> .

<#a0-v-star-spectrum-repinfo> a im:RepInfoAndGroup , im:RepresentationInformation ;
    rdfs:label "Representation Information for A0 V star spectrum" ;
    im:hasGroupMember <#a0-v-star-spectrum-structure> , <#a0-v-star-spectrum-semantics> ;
    im:hasStructureRepresentationInformation <#a0-v-star-spectrum-structure> ;
    im:hasSemanticRepresentationInformation <#a0-v-star-spectrum-semantics> .

<#a0-v-star-spectrum-structure> a im:RepInfoOrGroup , im:StructureRepresentationInformation ;
    rdfs:label "Structure of A0 V star spectrum: any one of these descriptions" ;
    im:hasGroupMember <#a0-v-star-spectrum-structure-1> , <#a0-v-star-spectrum-structure-2> .

<#a0-v-star-spectrum-structure-1> a im:StructureRepresentationInformation ;
    im:specificationLanguage "DFDL" ;
    bridge:hasStorageLocation <a0-v-star-spectrum.dfdl.xsd> .

<#a0-v-star-spectrum-structure-2> a im:StructureRepresentationInformation ;
    im:specificationLanguage "DRB SDF" ;
    bridge:hasStorageLocation <a0-v-star-spectrum.drb.xsd> .

<#a0-v-star-spectrum-semantics> a im:SemanticRepresentationInformation ;
    rdfs:label "Semantics of A0 V star spectrum" ;
    im:interpretedUsingRecurse <#a0-v-star-spectrum-view-1> ,
        <#a0-v-star-spectrum-element-1> ,
        <#a0-v-star-spectrum-element-2> ,
        <#a0-v-star-spectrum-element-3> ,
        <#a0-v-star-spectrum-element-4> ,
        <#a0-v-star-spectrum-element-5> ,
        <#a0-v-star-spectrum-element-6> .

<#a0-v-star-spectrum-view-1> a im:ViewSpecification , im:SemanticRepresentationInformation ;
    im:viewKind "table" ;
    bridge:hasStorageLocation <a0-v-star-spectrum-table-view.xml> .

<#a0-v-star-spectrum-element-1> a im:SemanticRepresentationInformation ;
    bridge:structuralPath "object" ;
    rdfs:label "Object" ;
    skos:definition "Name of the object observed, padded with spaces." .

<#a0-v-star-spectrum-element-2> a im:SemanticRepresentationInformation ;
    bridge:structuralPath "n_points" ;
    rdfs:label "Number of points" ;
    skos:definition "How many points the spectrum has." .

<#a0-v-star-spectrum-element-3> a im:SemanticRepresentationInformation ;
    bridge:structuralPath "point" ;
    rdfs:label "Point" ;
    skos:definition "One point of the spectrum." .

<#a0-v-star-spectrum-element-4> a im:SemanticRepresentationInformation ;
    bridge:structuralPath "point.wavelength" ;
    rdfs:label "Wavelength" ;
    skos:definition "Wavelength in air." ;
    rico:hasUnitOfMeasurement [ rdfs:label "Angstrom" ] .

<#a0-v-star-spectrum-element-5> a im:SemanticRepresentationInformation ;
    bridge:structuralPath "point.flux" ;
    rdfs:label "Flux density" ;
    skos:definition "Flux density per unit wavelength." ;
    rico:hasUnitOfMeasurement [ rdfs:label "erg/cm2/s/Angstrom" ] .

<#a0-v-star-spectrum-element-6> a im:SemanticRepresentationInformation ;
    bridge:structuralPath "point.error" ;
    rdfs:label "Flux density error" ;
    skos:definition "One-sigma uncertainty of the flux density." ;
    rico:hasUnitOfMeasurement [ rdfs:label "erg/cm2/s/Angstrom" ] .

