<?xml version="1.0" encoding="UTF-8"?>
<!--
  How to view "A0 V star spectrum" as a table, generated by archive-manager's RepInfo Tools:
  one row per "point" record, its fields as columns. Written for the tree DFDL and DRB decode it into. See
  oais-structure-api's TableViewSpecificationReader for the format.
-->
<tableView>
    <rows select="children" name="point"/>
    <columns>
        <column name="wavelength" type="double" unit="Angstrom" description="Wavelength: Wavelength in air."/>
        <column name="flux" type="float" unit="erg/cm2/s/Angstrom" description="Flux density: Flux density per unit wavelength."/>
        <column name="error" type="float" unit="erg/cm2/s/Angstrom" description="Flux density error: One-sigma uncertainty of the flux density."/>
    </columns>
</tableView>
