<?xml version="1.0" encoding="UTF-8"?>
<!--
  DRB SDF schema for "Bright star catalogue", generated by archive-manager's RepInfo Tools.
  Apply it with GAEL's DRB (fr.gael.drb, 2.5): e.g. the XQuery
  doc("data-file")/(this-schema.xsd)bright_star_catalogue, or oais-structure-drb's
  new DrbFormatSpecification(schemaUri).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sdf="http://www.gael.fr/2004/12/drb/sdf">

  <xs:annotation>
    <xs:documentation>A binary catalogue of bright stars: one fixed-length record per star, big-endian, to the end of the file.</xs:documentation>
  </xs:annotation>

  <xs:element name="bright_star_catalogue">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="star" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>Star: One star of the catalogue.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="name" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Star name: Common name, padded with spaces.</xs:documentation>
                  <xs:appinfo><sdf:block><sdf:length>12</sdf:length><sdf:encoding>ASCII</sdf:encoding></sdf:block></xs:appinfo>
                </xs:annotation>
              </xs:element>
              <xs:element name="ra" type="xs:double">
                <xs:annotation>
                  <xs:documentation>Right ascension (deg): Right ascension, ICRS, epoch J2000. Valid range: 0 to 360.</xs:documentation>
                  <xs:appinfo><sdf:block><sdf:length>8</sdf:length><sdf:byteOrder>MSB</sdf:byteOrder></sdf:block></xs:appinfo>
                </xs:annotation>
              </xs:element>
              <xs:element name="dec" type="xs:double">
                <xs:annotation>
                  <xs:documentation>Declination (deg): Declination, ICRS, epoch J2000. Valid range: -90 to 90.</xs:documentation>
                  <xs:appinfo><sdf:block><sdf:length>8</sdf:length><sdf:byteOrder>MSB</sdf:byteOrder></sdf:block></xs:appinfo>
                </xs:annotation>
              </xs:element>
              <xs:element name="vmag" type="xs:float">
                <xs:annotation>
                  <xs:documentation>Visual magnitude (mag): Apparent magnitude in the Johnson V band.</xs:documentation>
                  <xs:appinfo><sdf:block><sdf:length>4</sdf:length><sdf:byteOrder>MSB</sdf:byteOrder></sdf:block></xs:appinfo>
                </xs:annotation>
              </xs:element>
              <xs:element name="parallax" type="xs:float">
                <xs:annotation>
                  <xs:documentation>Parallax (mas): Trigonometric parallax. Valid range: 0 to .</xs:documentation>
                  <xs:appinfo><sdf:block><sdf:length>4</sdf:length><sdf:byteOrder>MSB</sdf:byteOrder></sdf:block></xs:appinfo>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
