<?xml version="1.0" encoding="UTF-8"?>
<!--
  How to view "Bright star catalogue" as a table, generated by archive-manager's RepInfo Tools:
  one row per "star" record, its fields as columns. Written for the tree DFDL and DRB decode it into. See
  oais-structure-api's TableViewSpecificationReader for the format.

  The ucd attributes were added by hand: IVOA Unified Content Descriptors,
  which let TOPCAT recognise the sky coordinates (pos.eq.ra, pos.eq.dec) for
  its sky plots.
-->
<tableView>
    <rows select="children" name="star"/>
    <columns>
        <column name="name" ucd="meta.id;meta.main" type="string" description="Star name: Common name, padded with spaces."/>
        <column name="ra" ucd="pos.eq.ra;meta.main" type="double" unit="deg" description="Right ascension: Right ascension, ICRS, epoch J2000."/>
        <column name="dec" ucd="pos.eq.dec;meta.main" type="double" unit="deg" description="Declination: Declination, ICRS, epoch J2000."/>
        <column name="vmag" ucd="phot.mag;em.opt.V" type="float" unit="mag" description="Visual magnitude: Apparent magnitude in the Johnson V band."/>
        <column name="parallax" ucd="pos.parallax.trig" type="float" unit="mas" description="Parallax: Trigonometric parallax."/>
    </columns>
</tableView>
