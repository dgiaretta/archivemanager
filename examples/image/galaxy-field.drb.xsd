-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sdf="http://www.gael.fr/2004/12/drb/sdf">

  <xs:annotation>
    <xs:documentation>An image in binary: the field's name, the width and height in pixels, then the rows in order, each its pixels' little-endian counts.</xs:documentation>
  </xs:annotation>

  <xs:element name="galaxy_field">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="object" type="xs:string">
          <xs:annotation>
            <xs:documentation>Object: Name of the field observed, padded with spaces.</xs:documentation>
            <xs:appinfo><sdf:block><sdf:length>16</sdf:length><sdf:encoding>ASCII</sdf:encoding></sdf:block></xs:appinfo>
          </xs:annotation>
        </xs:element>
        <xs:element name="width" type="xs:unsignedInt">
          <xs:annotation>
            <xs:documentation>Width: Number of pixels in each row.</xs:documentation>
            <xs:appinfo><sdf:block><sdf:length>4</sdf:length><sdf:byteOrder>LSB</sdf:byteOrder></sdf:block></xs:appinfo>
          </xs:annotation>
        </xs:element>
        <xs:element name="height" type="xs:unsignedInt">
          <xs:annotation>
            <xs:documentation>Height: Number of rows.</xs:documentation>
            <xs:appinfo><sdf:block><sdf:length>4</sdf:length><sdf:byteOrder>LSB</sdf:byteOrder></sdf:block></xs:appinfo>
          </xs:annotation>
        </xs:element>
        <xs:element name="row" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>Row: One row of the image, from the bottom of the field upwards.</xs:documentation>
            <xs:appinfo><sdf:block><sdf:occurrence query="../height" constant="false"/></sdf:block></xs:appinfo>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="pixel" type="xs:unsignedShort" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Counts (ADU): Detector counts in one pixel, sky background included.</xs:documentation>
                  <xs:appinfo><sdf:block><sdf:length>2</sdf:length><sdf:byteOrder>LSB</sdf:byteOrder><sdf:occurrence query="../../width" constant="false"/></sdf:block></xs:appinfo>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
