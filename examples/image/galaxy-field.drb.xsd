<?xml version="1.0" encoding="UTF-8"?>
<!--
  DRB SDF schema for "Galaxy field", generated by archive-manager's RepInfo Tools.
  Apply it with GAEL's DRB (fr.gael.drb, 2.5): e.g. the XQuery
