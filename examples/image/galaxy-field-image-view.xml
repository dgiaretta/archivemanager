<?xml version="1.0" encoding="UTF-8"?>
<!--
  How to view "Galaxy field" as an image, generated by archive-manager's RepInfo Tools:
  one row of the image per "row" record, its "pixel" values in order. Written for
  the tree DFDL and DRB decode it into. See oais-structure-api's
  ImageViewSpecificationReader for the format.
-->
<imageView>
    <rows select="children" name="row"/>
    <pixels select="children" name="pixel"/>
    <pixelType type="int" unit="ADU" description="Counts: Detector counts in one pixel, sky background included."/>
</imageView>
