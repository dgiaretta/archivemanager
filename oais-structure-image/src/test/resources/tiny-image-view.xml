<?xml version="1.0" encoding="UTF-8"?>
<!--
  How to view "Tiny image" as an image: one row of the image per "row"
  record, its "pixel" values in order. Written for the tree DFDL and DRB
  decode it into. See oais-structure-api's ImageViewSpecificationReader for
  the format; unit and description are optional.
-->
<imageView>
    <rows select="children" name="row"/>
    <pixels select="children" name="pixel"/>
    <pixelType type="int" unit="ADU" description="Counts: Detector counts in one pixel, sky background included."/>
</imageView>
