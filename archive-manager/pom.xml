<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>info.oais</groupId>
  <artifactId>archive-manager</artifactId>
  <version>0.1.0</version>
  <name>archive-manager</name>
  <description>Archive management application over RiC-O and OAIS, bridged by a custom bridging ontology</description>

  <properties>
    <java.version>17</java.version>
    <jena.version>4.10.0</jena.version>
    <!--
      Explicit source encoding for javac. Separate concern from the runtime
      JVM default-charset issue documented in README's internationalisation
      section (Java 17 predates JEP 400's "UTF-8 by default", so on Windows
      specifically, an unconfigured JVM's default charset follows the
      Windows ANSI code page, not UTF-8), this only affects how javac
      reads .java source files, not how the running app encodes data. Set
      anyway since it costs nothing and is good hygiene regardless.
    -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Version of the sibling oaiscore / oais-structure-* reactor modules
         (see ../pom.xml). This module isn't their child, so it can't
         inherit their dependencyManagement. -->
    <oais.structure.version>0.0.1-SNAPSHOT</oais.structure.version>
    <drb.version>2.5.13</drb.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- RDF store, SPARQL engine and Turtle I/O -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>apache-jena-libs</artifactId>
      <type>pom</type>
      <version>${jena.version}</version>
    </dependency>

    <!-- TDB2: the actual persistent, transactional triple store. Included
         transitively by apache-jena-libs above; declared explicitly here so
         it's clear from the POM alone that this app is TDB2-backed. -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-tdb2</artifactId>
      <version>${jena.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Lets GeneratedDescriptionsMatrixTest run a generated .ksy through the
         Kaitai adapter (when the Kaitai Struct compiler is installed). -->
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-kaitai</artifactId>
      <version>${oais.structure.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- CSV parsing for the NAM "Bulk Upload Spreadsheet" (Eternal SIP metadata) import.
         1.13.0 specifically: CSVFormat.Builder.get() (used below) was only added in this
         release, deprecating the older .build() method; confirmed against the project's own
         published release history (1.11.0: 2024-04-28, 1.12.0: 2024-09-21, 1.13.0:
         2025-01-08, ".get()" added exactly at 1.13.0), not assumed. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.13.0</version>
    </dependency>

    <!--
      Direct XLSX reading, bypassing a CSV export step entirely. This matters for more than
      convenience: Excel's plain "CSV (Comma delimited)" export writes the file using the
      system's ANSI code page, not UTF-8, unless you specifically choose "CSV UTF-8 (Comma
      delimited)", and the Windows ANSI code page has no representation for Thaana script
      at all, so that export step silently replaces every Dhivehi character with a literal
      "?" *in the file itself*, before this app ever sees it. Reading the XLSX directly avoids
      that lossy step altogether: XLSX stores text as UTF-8 XML internally, no ANSI code page
      involved anywhere in the path. poi-ooxml alone (not poi-scratchpad) is enough for .xlsx
      specifically; the legacy binary .xls format isn't supported by this app.
    -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.5</version>
    </dependency>

    <!-- OAIS core model (info.oais.infomodel.*) - previously a copy lived
         directly in this module's src tree - plus the DFDL adapter, which
         RepInfo Tools uses to run a generated .dfdl.xsd against an uploaded
         sample file. -->
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oaiscore</artifactId>
      <version>${oais.structure.version}</version>
    </dependency>
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-dfdl</artifactId>
      <version>${oais.structure.version}</version>
      <exclusions>
        <!-- Spring Boot already provides Logback as the SLF4J binding. -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-simple</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- The DRB adapter, which RepInfo Tools uses to run a generated DRB SDF
         schema against an uploaded sample file, plus DRB itself (LGPL v3, from
         ../third-party/maven-repo - see third-party/README.md) and the bridge
         that routes DRB's log4j 1.x logging calls into Logback. -->
    <!-- Renders the adapters' README files on the Help page. -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>0.22.0</version>
    </dependency>
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-drb</artifactId>
      <version>${oais.structure.version}</version>
    </dependency>
    <dependency>
      <groupId>fr.gael.drb</groupId>
      <artifactId>drb</artifactId>
      <version>${drb.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>log4j-over-slf4j</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <repositories>
    <!-- Same as the reactor root's: DRB isn't on Maven Central. -->
    <repository>
      <id>third-party-local</id>
      <url>file:${project.basedir}/../third-party/maven-repo</url>
    </repository>
  </repositories>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- DRB (LGPL v3) is bundled into the executable jar, so its notice and
           licence texts go into the jar too (META-INF/third-party/), for
           deployments that copy only the jar. -->
      <!-- The structure adapters' README files, rendered on the Help page
           (/help/engines/{dfdl,kaitai,drb}, see HelpController). -->
      <resource>
        <directory>${project.basedir}/../oais-structure-dfdl</directory>
        <targetPath>docs/engines</targetPath>
        <includes><include>README-DFDL.md</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../oais-structure-kaitai</directory>
        <targetPath>docs/engines</targetPath>
        <includes><include>README-KAITAI.md</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../oais-structure-drb</directory>
        <targetPath>docs/engines</targetPath>
        <includes><include>README-DRB.md</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../third-party</directory>
        <targetPath>META-INF/third-party</targetPath>
        <includes>
          <include>README.md</include>
          <include>licenses/**</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Generates a browsable HTML API doc site from the /** ... */ source
        comments, and bundles it into the jar so the running app's own Help
        page (/help) can link to a real /apidocs/index.html rather than a
        path that only exists on a dev machine's target/ directory. Runs at
        prepare-package, after src/main/resources has already been copied
        to target/classes by the normal process-resources phase, and before
        spring-boot-maven-plugin's repackage (bound to package) zips
        target/classes into the jar, so this addition rides along without
        needing its own copy of the resource-filtering machinery. Doubles as
        a validation step: a malformed javadoc comment fails the build here,
        the same way README says a malformed ontology Turtle file does at
        RdfStore.init().

        `mvn javadoc:javadoc` still works standalone too (writes to its
        default target/reports/apidocs/index.html) for a quicker doc-only
        check while writing comments, without a full package build.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <!--
            Real problems (malformed HTML, a broken @link, bad syntax) still fail the
            build, per the comment above; this codebase just doesn't follow the
            convention of a @param/@return/comment on every single method, so the
            "missing" doclint group alone is turned off to silence that noise rather
            than papering over every check by disabling doclint outright.
          -->
          <failOnError>true</failOnError>
          <doclint>all,-missing</doclint>
          <!--
            Also document the sibling reactor modules (see ../pom.xml), so the
            Help page's API reference covers the OAIS core model and the
            structure adapters, not just this app. Read straight from their
            source folders rather than via this module's dependencies, so the
            modules the app doesn't use at runtime (kaitai, demo, topcat)
            don't end up bundled into its jar. oais-structure-splat is left
            out: it only builds with -Psplat, against locally built jars.
          -->
          <sourcepath>${project.basedir}/src/main/java;${project.basedir}/../oaiscore/src/main/java;${project.basedir}/../oais-structure-api/src/main/java;${project.basedir}/../oais-structure-dfdl/src/main/java;${project.basedir}/../oais-structure-kaitai/src/main/java;${project.basedir}/../oais-structure-drb/src/main/java;${project.basedir}/../oais-structure-demo/src/main/java;${project.basedir}/../oais-structure-topcat/src/main/java</sourcepath>
          <!-- Libraries only those extra modules use, needed to resolve their types while documenting. -->
          <additionalDependencies>
            <additionalDependency>
              <groupId>io.kaitai</groupId>
              <artifactId>kaitai-struct-runtime</artifactId>
              <version>0.11</version>
            </additionalDependency>
            <additionalDependency>
              <groupId>uk.ac.starlink</groupId>
              <artifactId>stil</artifactId>
              <version>4.3.2</version>
            </additionalDependency>
          </additionalDependencies>
          <groups>
            <group>
              <title>Archive Manager application</title>
              <packages>info.oais.archive.manager*</packages>
            </group>
            <group>
              <title>OAIS core model (oaiscore)</title>
              <packages>info.oais.infomodel.config:info.oais.infomodel.implementation*:info.oais.infomodel.interfaces*:info.oais.infomodel.json:info.oais.infomodel.serialization</packages>
            </group>
            <group>
              <title>OAIS structure adapters (oais-structure-*)</title>
              <packages>info.oais.infomodel.structure*</packages>
            </group>
          </groups>
        </configuration>
        <executions>
          <execution>
            <id>generate-javadoc-for-help-page</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>javadoc</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>bundle-javadoc-into-jar</id>
            <!-- Same phase as the javadoc generation above; same-phase executions
                 run in POM declaration order, so this copy always happens after
                 that plugin has actually written the files being copied here. -->
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static/apidocs</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/reports/apidocs</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
