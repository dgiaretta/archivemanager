@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix im: <http://ontology.oais.org/im/> .
@prefix taxonomy: <http://ontology.oais.org/taxonomy/> .
@prefix oais: <http://ontology.oais.org/meta/> .

<http://ontology.oais.org/im/>
  a owl:Ontology ;
  rdfs:label "OAIS Information Model" ;
  rdfs:comment "Schema only. The knowledge base holds no instances, so this export declares classes and properties and asserts nothing about any individual." .

# -- annotation properties defined by this export, not by OAIS

oais:identifier
  a owl:AnnotationProperty ;
  rdfs:comment "The opaque frame identifier from the OQ-2 registry." .

oais:status
  a owl:AnnotationProperty ;
  rdfs:comment "Whether the class is an OAIS concept or a local extension, as the knowledge base itself declares it." .

oais:edition
  a owl:AnnotationProperty ;
  rdfs:comment "The OAIS edition the class is baselined on, as the knowledge base declares it." .

oais:sourceReference
  a owl:AnnotationProperty ;
  rdfs:comment "The OAIS figure or section the definition was taken from." .

oais:oaisConcept
  a owl:AnnotationProperty ;
  rdfs:comment "The reference-inventory concept this class was matched to." .

oais:slotRole
  a owl:AnnotationProperty ;
  rdfs:comment "How the Phase 4 crosswalk classifies the slot this property came from." .

oais:abstract
  a owl:AnnotationProperty ;
  rdfs:comment "True when the knowledge base declares the class abstract, which it does only where OAIS states a complete disjunction of subtypes." .

# -- classes

<http://ontology.oais.org/im/AccessRightsInformation>
  a owl:Class ;
  rdfs:label "Access Rights Information" ;
  skos:altLabel "Access RIghts Information" ;
  oais:identifier "c-0011" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Access Rights Information" ;
  oais:sourceReference "figure 4-19" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:comment "Access Rights Information: The information that identifies the access restrictions pertaining to the Content Data Object, including the legal framework, licensing terms, and access control." .

<http://ontology.oais.org/im/ArchivalInformationPackage>
  a owl:Class ;
  rdfs:label "Archival Information Package" ;
  oais:identifier "c-0020" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Archival Information Package" ;
  oais:sourceReference "figure 2-4" ;
  oais:sourceReference "figure 4-1" ;
  oais:sourceReference "figure 4-17" ;
  oais:sourceReference "figure 4-18" ;
  oais:sourceReference "figure 4-20" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationPackage> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasContentInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasPreservationDescriptiveInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Archival Information Package: An Information Package, consisting of the Content Information and the associated Preservation Description Information (PDI), which is preserved within an OAIS." .

<http://ontology.oais.org/im/Bit>
  a owl:Class ;
  rdfs:label "Bit" ;
  oais:identifier "c-0025" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Bit" ;
  oais:sourceReference "figure 4-10" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:comment "Bit: The unit of which a Digital Object is composed. OAIS has no glossary entry for Bit; 4.3.2.3.2 states that the Digital Object 'is itself composed of one or more bit sequences', and figure 4-10 models Bit as a class." .

<http://ontology.oais.org/im/CompletePreservationDescriptionInformation>
  a owl:Class ;
  rdfs:label "Complete Preservation Description Information" ;
  oais:identifier "c-0010" ;
  oais:status "local-extension" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:sourceReference "figure 4-19" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/PreservationDescriptionInformation> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasAccessRightsInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasContextInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasFixityInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasProvenanceInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasReferenceInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Complete Preservation Description Information: a Preservation Description Information object in which all five PDI categories are present. LOCAL EXTENSION -- OAIS does not name this class. It exists to express the requirement of 4.3.3.4, 'all classes of PDI information must be present in an AIP', which Protege Frames cannot state as a qualified cardinality on the AIP's PDI slot. Introduced by decision OQ-7 option C." .

<http://ontology.oais.org/im/ContentInformation>
  a owl:Class ;
  rdfs:label "Content Information" ;
  skos:altLabel "Content  Information" ;
  oais:identifier "c-0006" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Content Information" ;
  oais:sourceReference "figure 2-3" ;
  oais:sourceReference "figure 4-14" ;
  oais:sourceReference "figure 4-15" ;
  oais:sourceReference "figure 4-18" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/furtherDescribedBy> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Content Information: A set of information that is the original target of preservation. It is an Information Object composed of its Content Data Object and its Representation Information." .

<http://ontology.oais.org/im/ContextInformation>
  a owl:Class ;
  rdfs:label "Context Information" ;
  oais:identifier "c-0013" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Context Information" ;
  oais:sourceReference "figure 4-19" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:comment "Context Information: The information that documents the relationships of the Content Data Object to its environment. This includes why the Content Data Object was created and how it relates to other Content Data Objects." .

<http://ontology.oais.org/im/DataObject>
  a owl:Class ;
  rdfs:label "Data Object" ;
  oais:identifier "c-0002" ;
  oais:abstract "true"^^xsd:boolean ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Data Object" ;
  oais:sourceReference "figure 2-2" ;
  oais:sourceReference "figure 4-10" ;
  oais:sourceReference "figure 4-21" ;
  owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
      <http://ontology.oais.org/im/DigitalObject>
      <http://ontology.oais.org/im/PhysicalObject>
    )
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/interpretedUsing> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Data Object: Either a Physical Object or a Digital Object." .

<http://ontology.oais.org/im/DescriptiveInformation>
  a owl:Class ;
  rdfs:label "Descriptive Information" ;
  oais:identifier "c-0007" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Descriptive Information" ;
  oais:sourceReference "figure 4-1" ;
  oais:sourceReference "figure 4-2" ;
  oais:sourceReference "figure 4-14" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:comment "Descriptive Information: An Information Object which is a set of information, consisting primarily of Package Descriptions, which is provided to Data Management to support the finding, ordering, and retrieving of OAIS information holdings by Consumers." .

<http://ontology.oais.org/im/DigitalObject>
  a owl:Class ;
  rdfs:label "Digital Object" ;
  oais:identifier "c-0004" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Digital Object" ;
  oais:sourceReference "figure 4-10" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/DataObject> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasBit> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Digital Object: An object composed of a set of bit sequences." .

<http://ontology.oais.org/im/DisseminationInformationPackage>
  a owl:Class ;
  rdfs:label "Dissemination Information Package" ;
  oais:identifier "c-0021" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Dissemination Information Package" ;
  oais:sourceReference "figure 2-4" ;
  oais:sourceReference "figure 4-1" ;
  oais:sourceReference "figure 4-17" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationPackage> ;
  rdfs:comment "Dissemination Information Package: An Information Package, derived from one or more AIPs, and sent by Archives to the Consumer in response to a request to the OAIS." .

<http://ontology.oais.org/im/FixityInformation>
  a owl:Class ;
  rdfs:label "Fixity Information" ;
  oais:identifier "c-0012" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Fixity Information" ;
  oais:sourceReference "figure 4-19" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:comment "Fixity Information: The information which documents the mechanisms that ensure that the Content Data Object has not been altered in an undocumented manner." .

<http://ontology.oais.org/im/InformationObject>
  a owl:Class ;
  rdfs:label "Information Object" ;
  oais:identifier "c-0005" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Information Object" ;
  oais:sourceReference "figure 2-2" ;
  oais:sourceReference "figure 4-10" ;
  oais:sourceReference "figure 4-14" ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasDataObject> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasRepresentationInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Information Object: A Data Object together with its Representation Information." .

<http://ontology.oais.org/im/InformationPackage>
  a owl:Class ;
  rdfs:label "Information Package" ;
  oais:identifier "c-0018" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Information Package" ;
  oais:sourceReference "figure 4-15" ;
  oais:sourceReference "figure 4-17" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/delimitedBy> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/describedBy> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasContentInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Information Package: A logical container composed of optional Information Object(s). Associated with this Information Package is Packaging Information used to delimit and identify the Information Object and optional Package Description information used to facilitate searches for the Information Object." .

<http://ontology.oais.org/im/OAIS>
  a owl:Class ;
  rdfs:label "OAIS" ;
  oais:identifier "c-0001" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "OAIS (Open Archival Information System)" ;
  oais:sourceReference "figure 2-1" ;
  oais:sourceReference "figure 2-4" ;
  rdfs:comment "OAIS (Open Archival Information System): An Archive, consisting of an organization, which may be part of a larger organization, of people and systems, that has accepted the responsibility to preserve information and make it available for a Designated Community." .

<http://ontology.oais.org/im/OtherRepresentationInformation>
  a owl:Class ;
  rdfs:label "Other Representation Information" ;
  oais:identifier "c-0022" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Other Representation Information" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/RepresentationInformation> ;
  rdfs:comment "Other Representation Information: A type of Representation Information which cannot easily be classified as Structure Representation Information or Semantic Representation Information. It is a type of Information Object." .

<http://ontology.oais.org/im/PackageDescription>
  a owl:Class ;
  rdfs:label "Package Description" ;
  oais:identifier "c-0017" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Package Description" ;
  oais:sourceReference "figure 4-15" ;
  oais:sourceReference "figure 4-18" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/derivedFrom> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Package Description: The information intended for use by Access Aids. It is a type of Information Object." .

<http://ontology.oais.org/im/PackagingInformation>
  a owl:Class ;
  rdfs:label "Packaging Information" ;
  oais:identifier "c-0008" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Packaging Information" ;
  oais:sourceReference "figure 2-3" ;
  oais:sourceReference "figure 4-14" ;
  oais:sourceReference "figure 4-15" ;
  oais:sourceReference "figure 4-18" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasDescriptiveInformation> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/identifies> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Packaging Information: The information that describes how the components of an Information Package are logically or physically bound together and how to identify and extract the components. It is a type of Information Object." .

<http://ontology.oais.org/im/PhysicalObject>
  a owl:Class ;
  rdfs:label "Physical Object" ;
  oais:identifier "c-0003" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Physical Object" ;
  oais:sourceReference "figure 4-10" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/DataObject> ;
  rdfs:comment "Physical Object: An object (such as a moon rock, bio-specimen, microscope slide) with physically observable properties that represent information that is considered suitable for being adequately documented for preservation, distribution, and independent usage." .

<http://ontology.oais.org/im/PreservationDescriptionInformation>
  a owl:Class ;
  rdfs:label "Preservation Description Information" ;
  oais:identifier "c-0009" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Preservation Description Information" ;
  oais:sourceReference "figure 2-3" ;
  oais:sourceReference "figure 4-14" ;
  oais:sourceReference "figure 4-15" ;
  oais:sourceReference "figure 4-18" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasAccessRightsInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasContextInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasFixityInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasProvenanceInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasReferenceInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Preservation Description Information: The information, which along with Representation Information, is necessary for adequate preservation of the Content Data Object and which can be categorized as Provenance Information, Context Information, Reference Information, Fixity Information, and Access Rights Information. It is a type of Information Object." .

<http://ontology.oais.org/im/ProvenanceInformation>
  a owl:Class ;
  rdfs:label "Provenance Information" ;
  oais:identifier "c-0014" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Provenance Information" ;
  oais:sourceReference "figure 4-19" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:comment "Provenance Information: The information that documents the history of the Content Data Object. This information tells the origin or source of the Content Data Object, any changes that may have taken place since it was originated, and who has had custody of it since it was originated." .

<http://ontology.oais.org/im/ReferenceInformation>
  a owl:Class ;
  rdfs:label "Reference Information" ;
  oais:identifier "c-0015" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Reference Information" ;
  oais:sourceReference "figure 4-19" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:comment "Reference Information: The information that is used as an identifier for the Content Data Object. It also includes identifiers that allow outside systems to refer unambiguously to a particular Content Data Object." .

<http://ontology.oais.org/im/RepresentationInformation>
  a owl:Class ;
  rdfs:label "Representation Information" ;
  oais:identifier "c-0016" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Representation Information" ;
  oais:sourceReference "figure 2-2" ;
  oais:sourceReference "figure 4-10" ;
  oais:sourceReference "figure 4-14" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationObject> ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasOtherRepresentationInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasSemanticRepresentationInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/hasStructureRepresentationInformation> ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://ontology.oais.org/im/inverseOfInterpretedUsing> ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Representation Information: The information that maps a Data Object into more meaningful concepts so that the Data Object may be understood in ways exemplified by Preservation Objectives. It is a type of Information Object." .

<http://ontology.oais.org/im/SemanticRepresentationInformation>
  a owl:Class ;
  rdfs:label "Semantic Representation Information" ;
  skos:altLabel "Semantic Information" ;
  oais:identifier "c-0023" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Semantic Representation Information" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/RepresentationInformation> ;
  rdfs:comment "Semantic Representation Information: The Representation Information that further describes the meaning of the Data Object, and its parts or elements, beyond that provided by the Structure Representation Information." .

<http://ontology.oais.org/im/StructureRepresentationInformation>
  a owl:Class ;
  rdfs:label "Structure Representation Information" ;
  skos:altLabel "Structure Information" ;
  oais:identifier "c-0024" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Structure Representation Information" ;
  oais:sourceReference "figure 4-21" ;
  rdfs:subClassOf <http://ontology.oais.org/im/RepresentationInformation> ;
  rdfs:comment "Structure Representation Information: The Representation Information that imparts information about the arrangement of and the organization of the parts or elements of the Data Object." .

<http://ontology.oais.org/im/SubmissionInformationPackage>
  a owl:Class ;
  rdfs:label "Submission Information Package" ;
  oais:identifier "c-0019" ;
  oais:status "oais-core" ;
  oais:edition "CCSDS 650.0-M-3 (Issue 3, December 2024)" ;
  oais:oaisConcept "Submission Information Package" ;
  oais:sourceReference "figure 2-4" ;
  oais:sourceReference "figure 4-1" ;
  oais:sourceReference "figure 4-17" ;
  rdfs:subClassOf <http://ontology.oais.org/im/InformationPackage> ;
  rdfs:comment "Submission Information Package: An Information Package that is delivered by the Producer to the OAIS for use in the construction or update of one or more AIPs and/or the associated Descriptive Information." .

# -- compatibility with the deployed taxonomy IRIs.
# Name-derived IRIs cannot survive a rename, which is why
# decision OQ-2 minted opaque ones. The old IRIs are kept
# equivalent so existing queries and data keep resolving.

<http://ontology.oais.org/taxonomy/access_rights_information>
