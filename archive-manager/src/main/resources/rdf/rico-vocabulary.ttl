# -- datatype properties (curated subset; see note above) --

rico:title a owl:DatatypeProperty ; rdfs:label "Title" ; rdfs:comment "Record/RecordPart -> title text" .
rico:name a owl:DatatypeProperty ; rdfs:label "Name" ; rdfs:comment "Thing -> a simple name (usability shortcut for Appellation)" .
rico:generalDescription a owl:DatatypeProperty ; rdfs:label "General description" ; rdfs:comment "Thing -> free-text description" .
rico:scopeAndContent a owl:DatatypeProperty ; rdfs:label "Scope and content" ; rdfs:comment "Record/RecordPart/RecordSet -> scope and content note" .
rico:history a owl:DatatypeProperty ; rdfs:label "History" ; rdfs:comment "Thing -> free-text history (usability shortcut for Event)" .
rico:type a owl:DatatypeProperty ; rdfs:label "Type" ; rdfs:comment "Thing -> a plain-text category (usability shortcut for a Type class)" .
rico:identifier a owl:DatatypeProperty ; rdfs:label "Identifier" ; rdfs:comment "Thing -> a simple identifier string" .
rico:textualValue a owl:DatatypeProperty ; rdfs:label "Textual value" ; rdfs:comment "Appellation/Date/Extent -> literal text value" .
rico:normalizedValue a owl:DatatypeProperty ; rdfs:label "Normalized value" ; rdfs:comment "Appellation/Date/Extent -> normalized value" .
rico:conditionsOfAccess a owl:DatatypeProperty ; rdfs:label "Conditions of access" ; rdfs:comment "Instantiation -> access conditions text" .
rico:conditionsOfUse a owl:DatatypeProperty ; rdfs:label "Conditions of use" ; rdfs:comment "Instantiation -> use conditions text" .
rico:ruleFollowed a owl:DatatypeProperty ; rdfs:label "Rule followed" ; rdfs:comment "Thing -> free-text rule reference (usability shortcut for Rule)" .
rico:note a owl:DatatypeProperty ; rdfs:label "Note" ; rdfs:comment "Thing -> generic note" .
rico:physicalCharacteristicsNote a owl:DatatypeProperty ; rdfs:label "Physical characteristics note" ; rdfs:comment "Instantiation -> physical characteristics note" .
rico:authenticityNote a owl:DatatypeProperty ; rdfs:label "Authenticity note" ; rdfs:comment "Instantiation -> authenticity note" .
rico:integrityNote a owl:DatatypeProperty ; rdfs:label "Integrity note" ; rdfs:comment "Instantiation -> integrity note" .
rico:quantity a owl:DatatypeProperty ; rdfs:label "Quantity" ; rdfs:comment "Extent -> numeric quantity" .
rico:measure a owl:DatatypeProperty ; rdfs:label "Measure" ; rdfs:comment "Coordinates/Extent -> a measurement value" .
rico:geographicalCoordinates a owl:DatatypeProperty ; rdfs:label "Geographical coordinates" ; rdfs:comment "Coordinates -> plain-text coordinates" .
