# -- class hierarchy (subclass relationships) --
#
# Only the branches this application's own queries actually walk (Agent,
# RecordResource, Event, Rule) are asserted here -- this is NOT a
# reconstruction of RiC-O's full class hierarchy, which is much deeper (in
# particular, rico:Relation alone has on the order of 90 subclasses that
# aren't represented here at all). What's below is reconstructed from
# general familiarity with RiC-O's structure rather than transcribed from
# the authoritative OWL file (which isn't bundled here -- see the note at
# the top of this file); treat it as best-effort, not a verified
# re-publication of the spec, and extend it if your data needs more of the
# hierarchy walked generically.

rico:Person rdfs:subClassOf rico:Agent .
rico:Group rdfs:subClassOf rico:Agent .
rico:CorporateBody rdfs:subClassOf rico:Group .
rico:Family rdfs:subClassOf rico:Group .
rico:Position rdfs:subClassOf rico:Agent .
rico:Mechanism rdfs:subClassOf rico:Agent .

rico:Record rdfs:subClassOf rico:RecordResource .
rico:RecordPart rdfs:subClassOf rico:RecordResource .
rico:RecordSet rdfs:subClassOf rico:RecordResource .

rico:Activity rdfs:subClassOf rico:Event .

rico:Mandate rdfs:subClassOf rico:Rule .

# -- object properties (curated subset; see note above) --

rico:hasCreator a owl:ObjectProperty ; rdfs:label "Has creator" ; rdfs:comment "Record Resource or Instantiation -> Agent that created it" .
rico:hasOrHadCreator a owl:ObjectProperty ; rdfs:label "Has or had creator" ; rdfs:comment "alias of hasCreator (past-inclusive form)" .
rico:isCreatorOf a owl:ObjectProperty ; rdfs:label "Is creator of" ; rdfs:comment "inverse of hasCreator" .
rico:hasAccumulator a owl:ObjectProperty ; rdfs:label "Has accumulator" ; rdfs:comment "Record Resource or Instantiation -> Agent that accumulated it" .
rico:hasCollector a owl:ObjectProperty ; rdfs:label "Has collector" ; rdfs:comment "-> Agent that collected it" .
rico:hasPublisher a owl:ObjectProperty ; rdfs:label "Has publisher" ; rdfs:comment "-> Agent that published it" .
rico:hasSender a owl:ObjectProperty ; rdfs:label "Has sender" ; rdfs:comment "-> Agent that sent it" .
rico:hasReceiver a owl:ObjectProperty ; rdfs:label "Has receiver" ; rdfs:comment "-> Agent that received it" .
rico:hasAddressee a owl:ObjectProperty ; rdfs:label "Has addressee" ; rdfs:comment "-> Agent addressed by it" .
rico:hasOrHadHolder a owl:ObjectProperty ; rdfs:label "Has or had holder" ; rdfs:comment "-> Agent currently or formerly holding it" .
rico:hasOrHadManager a owl:ObjectProperty ; rdfs:label "Has or had manager" ; rdfs:comment "-> Agent managing it" .
rico:hasOrHadIntellectualPropertyRightsHolder a owl:ObjectProperty ; rdfs:label "Has or had intellectual property rights holder" ; rdfs:comment "-> Agent holding IP rights" .
rico:hasOrHadOwner a owl:ObjectProperty ; rdfs:label "Has or had owner" ; rdfs:comment "-> Agent owning it" .
rico:hasOrHadController a owl:ObjectProperty ; rdfs:label "Has or had controller" ; rdfs:comment "-> Agent controlling it" .
rico:hasOrHadConstituent a owl:ObjectProperty ; rdfs:label "Has or had constituent" ; rdfs:comment "whole -> part (Record/RecordPart/RecordSet)" .
rico:isOrWasConstituentOf a owl:ObjectProperty ; rdfs:label "Is or was constituent of" ; rdfs:comment "inverse of hasOrHadConstituent" .
rico:hasOrHadComponent a owl:ObjectProperty ; rdfs:label "Has or had component" ; rdfs:comment "Instantiation -> component Instantiation" .
rico:isOrWasComponentOf a owl:ObjectProperty ; rdfs:label "Is or was component of" ; rdfs:comment "inverse of hasOrHadComponent" .
rico:hasOrHadInstantiation a owl:ObjectProperty ; rdfs:label "Has or had instantiation" ; rdfs:comment "RecordResource -> Instantiation" .
rico:isOrWasInstantiationOf a owl:ObjectProperty ; rdfs:label "Is or was instantiation of" ; rdfs:comment "inverse of hasOrHadInstantiation" .
rico:hasOrHadDerivedInstantiation a owl:ObjectProperty ; rdfs:label "Has or had derived instantiation" ; rdfs:comment "Instantiation -> derived Instantiation" .
rico:isOrWasDerivedFromInstantiation a owl:ObjectProperty ; rdfs:label "Is or was derived from instantiation" ; rdfs:comment "inverse" .
rico:hasOrHadAnalogueInstantiation a owl:ObjectProperty ; rdfs:label "Has or had analogue instantiation" ; rdfs:comment "-> analogue Instantiation" .
rico:hasOrHadDigitalInstantiation a owl:ObjectProperty ; rdfs:label "Has or had digital instantiation" ; rdfs:comment "-> digital Instantiation" .
rico:isFunctionallyEquivalentTo a owl:ObjectProperty ; rdfs:label "Is functionally equivalent to" ; rdfs:comment "Instantiation <-> Instantiation" .
rico:isOrWasRegulatedBy a owl:ObjectProperty ; rdfs:label "Is or was regulated by" ; rdfs:comment "RecordResource/Instantiation -> Rule/Mandate" .
rico:isOrWasResponsibleForEnforcing a owl:ObjectProperty ; rdfs:label "Is or was responsible for enforcing" ; rdfs:comment "Agent -> Rule" .
rico:isOrWasEnforcedBy a owl:ObjectProperty ; rdfs:label "Is or was enforced by" ; rdfs:comment "inverse" .
rico:authorizes a owl:ObjectProperty ; rdfs:label "Authorizes" ; rdfs:comment "Agent (mandating) -> Agent (mandated), via Mandate" .
rico:isOrWasUnderAuthorityOf a owl:ObjectProperty ; rdfs:label "Is or was under authority of" ; rdfs:comment "Agent -> Agent with authority over it" .
rico:hasOrHadAuthorityOver a owl:ObjectProperty ; rdfs:label "Has or had authority over" ; rdfs:comment "inverse" .
rico:hasOrganicProvenance a owl:ObjectProperty ; rdfs:label "Has organic provenance" ; rdfs:comment "RecordResource/Instantiation -> Agent (organic provenance)" .
rico:isOrganicProvenanceOf a owl:ObjectProperty ; rdfs:label "Is organic provenance of" ; rdfs:comment "inverse" .
rico:hasOrganicOrFunctionalProvenance a owl:ObjectProperty ; rdfs:label "Has organic or functional provenance" ; rdfs:comment "RecordResource/Instantiation -> Agent or Activity" .
rico:isOrganicOrFunctionalProvenanceOf a owl:ObjectProperty ; rdfs:label "Is organic or functional provenance of" ; rdfs:comment "inverse" .
rico:hasOrHadParticipant a owl:ObjectProperty ; rdfs:label "Has or had participant" ; rdfs:comment "Event/Activity -> Agent" .
rico:isOrWasParticipantIn a owl:ObjectProperty ; rdfs:label "Is or was participant in" ; rdfs:comment "inverse" .
rico:performsOrPerformed a owl:ObjectProperty ; rdfs:label "Performs or performed" ; rdfs:comment "Agent -> Activity" .
rico:isOrWasPerformedBy a owl:ObjectProperty ; rdfs:label "Is or was performed by" ; rdfs:comment "inverse" .
rico:hasOrHadSubevent a owl:ObjectProperty ; rdfs:label "Has or had subevent" ; rdfs:comment "Event -> sub-Event" .
rico:isOrWasSubeventOf a owl:ObjectProperty ; rdfs:label "Is or was subevent of" ; rdfs:comment "inverse" .
rico:documents a owl:ObjectProperty ; rdfs:label "Documents" ; rdfs:comment "Event/Activity -> Thing it documents" .
rico:documentedBy a owl:ObjectProperty ; rdfs:label "Documented by" ; rdfs:comment "inverse" .
rico:hasOrHadSubordinate a owl:ObjectProperty ; rdfs:label "Has or had subordinate" ; rdfs:comment "Agent -> subordinate Agent" .
rico:isOrWasSubordinateTo a owl:ObjectProperty ; rdfs:label "Is or was subordinate to" ; rdfs:comment "inverse" .
rico:hasOrHadMember a owl:ObjectProperty ; rdfs:label "Has or had member" ; rdfs:comment "Group -> member Agent" .
rico:isOrWasMemberOf a owl:ObjectProperty ; rdfs:label "Is or was member of" ; rdfs:comment "inverse" .
