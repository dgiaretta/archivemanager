  <artifactId>oais-structure-splat</artifactId>
  <name>oais-structure-splat</name>
  <description>
    Opens data described by a DFDL schema, a Kaitai Struct generated class, or
    a DRB descriptor as a spectrum in SPLAT (Starlink's spectral analysis
    tool), by reusing oais-structure-topcat's OaisStructureTableBuilder to
    build a uk.ac.starlink.table.StarTable, then wrapping it as a SpecData via
    SpecDataFactory and handing it to a live SplatBrowser. See this module's
    own README section (in the project root README) for how splat.jar and its
    dependency closure were obtained: unlike stil, splat is not published on
    Maven Central, so it was built from the starjava source tree and
    installed into the local Maven repo under the synthetic groupId below.
  </description>

  <properties>
    <!-- splat.jar and everything its own MANIFEST.MF Class-Path names,
         installed locally from a from-source starjava build (see the root
         README's "SPLAT example description" section). Not a real,
         independently-versioned upstream release, hence "-local". -->
    <starjava.local.version>0.0.1-local</starjava.local.version>

    <!-- jniast's native library (used by SPLAT's AST/WCS support, loaded as
         soon as any SpecData is built - see uk.ac.starlink.ast.AstObject)
         has no Maven Central presence and, unlike splat.jar itself, was
         never copied into the "installed" starjava/lib tree by "ant
         install" either - it only exists under the source checkout's own
         jniast/lib/<arch> (see the root README's "SPLAT example
         description" section). Point this at that directory; override with
         -Djniast.native.dir=... if your starjava checkout lives elsewhere. -->
    <jniast.native.dir>C:\Users\david\starjava\source\jniast\lib\amd64</jniast.native.dir>
  </properties>

