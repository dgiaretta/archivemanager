<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>info.oais.infomodel</groupId>
    <artifactId>oais-structure-adapters</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>oais-structure-drb</artifactId>
  <name>oais-structure-drb</name>
  <description>
    ExecutableStructureRepInfo backed by GAEL's Java DRB (Data Request
    Broker), reached by reflection so this module compiles without DRB;
    applications add DRB at runtime. See README-DRB.md.
  </description>

  <dependencies>
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-api</artifactId>
    </dependency>

    <!-- DRB itself only for this module's tests: applications that use the
         adapter add fr.gael.drb:drb (LGPL v3, from ../third-party/maven-repo)
         and org.slf4j:log4j-over-slf4j at runtime - see README-DRB.md. -->
    <dependency>
      <groupId>fr.gael.drb</groupId>
      <artifactId>drb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>log4j-over-slf4j</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
