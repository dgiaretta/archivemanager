<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>info.oais.infomodel</groupId>
    <artifactId>oais-structure-adapters</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>oais-structure-topcat</artifactId>
  <name>oais-structure-topcat</name>
  <description>
    A uk.ac.starlink.table.TableBuilder plugin for TOPCAT/STIL that opens
    data described by a DFDL schema, a Kaitai Struct generated class, or a
    DRB descriptor -- reusing oais-structure-api's existing
    StructureInterpreterFactory / TableSemanticRepInfo pipeline rather than
    parsing anything itself. See this module's own README section (in the
    project root README) for the sidecar-file convention this builder looks
    for and the -Dstartable.readers launch flag needed to register it with
    TOPCAT.
  </description>

  <dependencies>
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-api</artifactId>
    </dependency>

    <dependency>
      <groupId>uk.ac.starlink</groupId>
      <artifactId>stil</artifactId>
    </dependency>

    <!-- Compile-scope, not test-only: OaisStructureTableBuilder constructs
         each engine's own FormatSpecification subclass directly (that's the
         only per-engine-specific code this module has, see its Javadoc), so
         it depends on all three adapters, the same way oais-structure-demo
         does. kaitai-struct-runtime comes transitively via
         oais-structure-kaitai; DRB itself, which oais-structure-drb only
         reaches by reflection, is added at runtime scope below. -->
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-dfdl</artifactId>
    </dependency>
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-kaitai</artifactId>
    </dependency>
    <dependency>
      <groupId>info.oais.infomodel</groupId>
      <artifactId>oais-structure-drb</artifactId>
    </dependency>
    <!-- DRB (LGPL v3, from ../third-party/maven-repo) plus the bridge for its
         log4j 1.x logging calls, so copy-dependencies includes them. -->
    <dependency>
      <groupId>fr.gael.drb</groupId>
      <artifactId>drb</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>log4j-over-slf4j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
