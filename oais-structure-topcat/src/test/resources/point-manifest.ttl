# One "point" record, described in DFDL and (equivalently) by the Kaitai
# Struct class generated from point2d.ksy; the table view and what x means.
@prefix im:     <http://ontology.oais.info/im/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

<#point> a im:DigitalObject ;
    rdfs:label "A point" ;
    im:hasStorageLocation <point.bin> ;
    im:interpretedUsing <#repinfo> .

<#repinfo> a im:RepInfoAndGroup , im:RepresentationInformation ;
    im:hasGroupMember <#structure> , <#semantics> ;
    im:hasStructureRepresentationInformation <#structure> ;
    im:hasSemanticRepresentationInformation <#semantics> .

<#structure> a im:RepInfoOrGroup , im:StructureRepresentationInformation ;
    im:hasGroupMember <#dfdl> , <#kaitai> .

<#dfdl> a im:StructureRepresentationInformation ;
    im:specificationLanguage "DFDL" ;
    im:hasStorageLocation <point.dfdl.xsd> .

<#kaitai> a im:StructureRepresentationInformation ;
    im:specificationLanguage "Kaitai Struct" ;
    im:generatedClassName "info.oais.infomodel.structure.kaitai.generated.Point2d" .

<#semantics> a im:SemanticRepresentationInformation ;
    im:interpretedUsingRecurse <#view> , <#x> .

<#view> a im:ViewSpecification , im:SemanticRepresentationInformation ;
    im:viewKind "table" ;
    im:hasStorageLocation <point-table-view.xml> .

<#x> a im:SemanticRepresentationInformation ;
    im:structuralPath "point.x" ;
    rdfs:label "X ordinate" ;
    skos:definition "Distance along the x axis." ;
    im:hasUnitOfMeasurement [ rdfs:label "m" ] .
